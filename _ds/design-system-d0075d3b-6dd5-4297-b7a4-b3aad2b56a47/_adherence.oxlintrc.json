{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badges/**",
              "components/buttons/**",
              "components/cards/**",
              "components/donation/**",
              "components/media/**",
              "components/trust/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Almarai|Cairo|Montserrat|Poppins|Tajawal))/i]",
        "message": "Font not provided by the design system. Available: Almarai, Cairo, Montserrat, Poppins, Tajawal."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|solid|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, solid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|red|green|deep|onImage)$/]",
        "message": "<Badge> tone must be one of 'gold' | 'red' | 'green' | 'deep' | 'onImage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|as|full|disabled|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, as, full, disabled, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|gold|support|light|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'gold' | 'support' | 'light' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CertificateCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|holder|note|logo|style|key|ref|className|style|children)$/]",
        "message": "<CertificateCard> doesn't accept that prop. Declared props: label, holder, note, logo, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonationPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|intentions|frequencies|amounts|currency|donateHref|note|style|key|ref|className|style|children)$/]",
        "message": "<DonationPanel> doesn't accept that prop. Declared props: eyebrow, title, intentions, frequencies, amounts, currency, donateHref, note, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FundCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|note|href|tone|style|key|ref|className|style|children)$/]",
        "message": "<FundCard> doesn't accept that prop. Declared props: title, note, href, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FundCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<FundCard> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|category|title|text|raised|goal|donors|note|href|donateHref|featured|official|style|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: image, category, title, text, raised, goal, donors, note, href, donateHref, featured, official, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReelCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|image|href|badge|style|key|ref|className|style|children)$/]",
        "message": "<ReelCard> doesn't accept that prop. Declared props: title, image, href, badge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatMetric'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|verified|style|key|ref|className|style|children)$/]",
        "message": "<StatMetric> doesn't accept that prop. Declared props: value, label, tone, verified, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatMetric'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:deep|red|gold)$/]",
        "message": "<StatMetric> tone must be one of 'deep' | 'red' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoryCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|image|caption|index|href|style|key|ref|className|style|children)$/]",
        "message": "<StoryCircle> doesn't accept that prop. Declared props: label, image, caption, index, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustList'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|items|style|key|ref|className|style|children)$/]",
        "message": "<TrustList> doesn't accept that prop. Declared props: eyebrow, title, items, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
